{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "void2_small",
        "padding": {
            "top": 1,
            "right": 2
        }
    },
    "display": {
        "separator": "  󰅂 "
    },
    "modules": [
        "break",
        {
            "type": "title",
            "format": "{user-name-colored}@{host-name-colored}"
        },
        {
            "type": "host",
            "key": "  󰌢 Host",
            "keyColor": "blue"
        },
        {
            "type": "os",
            "key": "  󰣠 OS",
            "keyColor": "green"
        },
        {
            "type": "kernel",
            "key": "  󰒋 Kernel",
            "keyColor": "cyan"
        },
        {
            "type": "packages",
            "format": "{} (xbps)",
            "key": "  󰏖 Packages",
            "keyColor": "yellow"
        },
        {
            "type": "uptime",
            "format": "{2}h {3}m",
            "key": "  󰅐 Uptime",
            "keyColor": "magenta"
        },
        {
            "type": "memory",
            "key": "  󰍛 Memory",
            "keyColor": "blue"
        },
        "break",
        {
            "type": "colors",
            "symbol": "circle"
        },
        "break"
    ]
}
