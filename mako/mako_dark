# ~/.config/mako/mako_dark - Catppuccin Mocha Notifications

font=JetBrainsMono Nerd Font, UbuntuMono Nerd Font 10.5
background-color=#1e1e2ef0
text-color=#cdd6f4
border-color=#89b4fa
border-size=2
border-radius=8
progress-color=source #89b4fa

margin=12
padding=12,16
width=360
height=160
default-timeout=5000
icons=1
max-icon-size=48

[urgency=low]
border-color=#313244
default-timeout=3000

[urgency=normal]
border-color=#89b4fa

[urgency=high]
border-color=#f38ba8
text-color=#f38ba8
default-timeout=0
