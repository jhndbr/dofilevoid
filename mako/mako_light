# ~/.config/mako/mako_light - Warm Cream Light Notifications

font=JetBrainsMono Nerd Font, UbuntuMono Nerd Font 10.5
background-color=#f2e9def5
text-color=#575268
border-color=#9c6644
border-size=2
border-radius=8
progress-color=source #9c6644

margin=12
padding=12,16
width=360
height=160
default-timeout=5000
icons=1
max-icon-size=48

[urgency=low]
border-color=#d3cec4
default-timeout=3000

[urgency=normal]
border-color=#9c6644

[urgency=high]
border-color=#c34043
text-color=#c34043
default-timeout=0
