# ~/.config/sway/theme.d/theme_light
# Warm Cream Light Palette

# Colors
set $background #f2e9de
set $foreground #575268
set $accent     #9c6644
set $urgent     #c34043
set $inactive   #d3cec4
set $border_act #9c6644
set $border_in  #d3cec4

# Client Window Borders
# class                 border      background  text        indicator   child_border
client.focused          $border_act $background $foreground $accent     $border_act
client.focused_inactive $border_in  $background $foreground $border_in  $border_in
client.unfocused        $border_in  $background $foreground $border_in  $border_in
client.urgent           $urgent     $urgent     $background $urgent     $urgent

# Swaybar Configuration
bar {
    position top
    status_command $HOME/.local/bin/swaybar.sh
    font pango:JetBrainsMono Nerd Font, UbuntuMono Nerd Font, monospace 10
    height 28
    status_padding 2
    status_edge_padding 8
    
    colors {
        background $background
        statusline $foreground
        separator  #d3cec4
        
        # Border, Background, Text
        focused_workspace  $accent $accent $background
        active_workspace   $background $background $accent
        inactive_workspace $background $background $foreground
        urgent_workspace   $urgent $urgent $background
        binding_mode       #40a02b #40a02b $background
    }
}
