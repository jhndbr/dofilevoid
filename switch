#!/usr/bin/env bash
# ==============================================================================
# switch - Dynamic Theme Switcher (Dark / Light) for Sway, Alacritty & Fuzzel
# ==============================================================================

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}"

SWAY_DIR="$CONFIG_DIR/sway"
ALACRITTY_DIR="$CONFIG_DIR/alacritty"
FUZZEL_DIR="$CONFIG_DIR/fuzzel"

LIGHT_THEME="$SWAY_DIR/theme.d/theme_light"
DARK_THEME="$SWAY_DIR/theme.d/theme_dark"

ALACRITTY_LIGHT="$ALACRITTY_DIR/alacritty_light.toml"
ALACRITTY_DARK="$ALACRITTY_DIR/alacritty_dark.toml"

FUZZEL_LIGHT="$FUZZEL_DIR/light.ini"
FUZZEL_DARK="$FUZZEL_DIR/dark.ini"

BG_LIGHT="dfd5c7"
BG_DARK="1e1e2e"

mkdir -p "$SWAY_DIR" "$ALACRITTY_DIR" "$FUZZEL_DIR"

switch_theme() {
    local theme_name="$1"
    local sway_theme="$2"
    local alacritty_theme="$3"
    local fuzzel_theme="$4"
    local bg_color="$5"

    # Link Sway Theme
    if [ -f "$sway_theme" ]; then
        ln -sf "$sway_theme" "$SWAY_DIR/theme"
    fi

    # Link Alacritty Theme
    if [ -f "$alacritty_theme" ]; then
        ln -sf "$alacritty_theme" "$ALACRITTY_DIR/alacritty.toml"
    fi

    # Link Fuzzel Theme
    if [ -f "$fuzzel_theme" ]; then
        ln -sf "$fuzzel_theme" "$FUZZEL_DIR/fuzzel.ini"
    fi

    # Set background color or image
    if command -v swaybg >/dev/null 2>&1; then
        pkill swaybg 2>/dev/null || true
        if [ -f "$HOME/Pictures/wallpaper.png" ]; then
            swaybg -i "$HOME/Pictures/wallpaper.png" -m fill 2>/dev/null &
        else
            swaybg -c "$bg_color" 2>/dev/null &
        fi
    fi

    # Reload Sway if running
    if [ -n "$SWAYSOCK" ] && command -v swaymsg >/dev/null 2>&1; then
        swaymsg reload >/dev/null 2>&1
    fi

    if command -v notify-send >/dev/null 2>&1 && [ -n "$WAYLAND_DISPLAY" ]; then
        notify-send -a "Theme Switcher" "Tema cambiado" "Modo $theme_name aplicado correctamente." -t 2000 2>/dev/null || true
    fi
}

current_theme="dark"
if [ -L "$SWAY_DIR/theme" ]; then
    target=$(readlink -f "$SWAY_DIR/theme" 2>/dev/null || echo "")
    if [[ "$target" == *"theme_light"* ]]; then
        current_theme="light"
    fi
fi

case "$1" in
    light)
        switch_theme "Claro" "$LIGHT_THEME" "$ALACRITTY_LIGHT" "$FUZZEL_LIGHT" "$BG_LIGHT"
        ;;
    dark)
        switch_theme "Oscuro" "$DARK_THEME" "$ALACRITTY_DARK" "$FUZZEL_DARK" "$BG_DARK"
        ;;
    toggle)
        if [ "$current_theme" = "dark" ]; then
            switch_theme "Claro" "$LIGHT_THEME" "$ALACRITTY_LIGHT" "$FUZZEL_LIGHT" "$BG_LIGHT"
        else
            switch_theme "Oscuro" "$DARK_THEME" "$ALACRITTY_DARK" "$FUZZEL_DARK" "$BG_DARK"
        fi
        ;;
    auto|*)
        CURRENT_HOUR=$(date +%H)
        if [ "$CURRENT_HOUR" -ge 7 ] && [ "$CURRENT_HOUR" -lt 19 ]; then
            switch_theme "Claro" "$LIGHT_THEME" "$ALACRITTY_LIGHT" "$FUZZEL_LIGHT" "$BG_LIGHT"
        else
            switch_theme "Oscuro" "$DARK_THEME" "$ALACRITTY_DARK" "$FUZZEL_DARK" "$BG_DARK"
        fi
        ;;
esac
